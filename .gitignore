# Ignore everything in this directory
.DS_Store
.classpath
.project
/bin/
/build/
/build-lib/
/build-beast/
/build-beastfx/
/build-test/
/test-reports/
/dist/
/templates/MascotBSSVS/
src/beast/mascot/operators/BitFlipBSSVSOperator.java
/beast-source/
/beastfx-source/
/target/
/tmp/
/deps/
# NOT ignoring /.github/: this branch ships .github/workflows/ci-publish.yml, and an
# ignore rule here would silently drop future workflow changes from `git status`.
# Ignore the contents of /docs/ rather than the directory itself, so that the
# exceptions below are reachable -- git does not descend into an excluded directory.
/docs/*
# Design specs and implementation plans belong in the repo.
!/docs/superpowers/
!/docs/WeightTransformAdaptation.md
# The evaluation pipeline's dataset docs (baseline test results, throughput, README).
!/docs/evaluation/

# Run outputs, not the example XMLs/templates that produce them: the evaluation
# pipeline needs the corpus itself in git so every branch shares the same inputs.
*.log
*.trees
*.xml.state
/runs/
.snakemake/

iecor-fit.candidate-cases.csv
iecor-fit.candidate-summary.tsv
iecor-fit.summary.tsv
iecor-fit.weights.csv
learnedweights-iecor.summary.tsv
TODO.md

*/.snakemake
/examples/**/run?.*.tsv
/examples/infb_HA_141/*/*
/examples/lassaL_kli22/*/*
/surrogate_training/*

# Large alignment the user supplies locally, not checked in.
/examples/lassaL_kli22/*.fasta
/examples/lassaL_kli22/*.tsv
/examples/lassaL_kli22/*.nex
.snakemake/
__pycache__/

# Written by MCMC runs in the tests.
state.backup.xml
