        <provider classname="targetedbeast.operatorschedule.TargetedOperatorSchedule"/>
        <provider classname="targetedbeast.edgeweights.ConstantWeights"/>
        <provider classname="targetedbeast.likelihood.RapidGenericTreeLikelihood"/>
        <provider classname="targetedbeast.coalescent.RapidCoalescent"/>
        <provider classname="targetedbeast.operators.NodeRandomizer2"/>
        <provider classname="targetedbeast.operators.NodeRandomizer22"/>
        <provider classname="targetedbeast.altoperators.LengthConsistentUpDown"/>
        <provider classname="targetedbeast.altoperators.SubtreeSlide2"/>
        <provider classname="targetedbeast.altoperators.SubtreeSlide5"/>
        <provider classname="targetedbeast.altoperators.Uni"/>
        <provider classname="targetedbeast.altoperators.Uniform"/>
        <provider classname="targetedbeast.altoperators.Uniform2"/>
        <provider classname="targetedbeast.altoperators.WilsonBalding2"/>
        <provider classname="targetedbeast.util.Alignment2PCA"/>
