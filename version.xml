<package name='TargetedBeast' version='1.1.0'>
  <depends on='BEAST.base' atleast='2.8.0'/>
  <depends on='BEAST.app' atleast='2.8.0'/>
  <depends on='BEASTlabs'/>
  <depends on='BDMM-Prime'/>
  <depends on='feast' atleast='11.0.1'/>


      <service type="beast.base.core.BEASTInterface">


        <provider classname="targetedbeast.edgeweights.ConsensusWeights"/>
        <provider classname="targetedbeast.edgeweights.ParsimonyWeights"/>
        <provider classname="targetedbeast.edgeweights.ParsimonyWeights2"/>
        <provider classname="targetedbeast.edgeweights.PCAWeights"/>
        <provider classname="targetedbeast.edgeweights.PCAWeights2"/>
        <provider classname="targetedbeast.edgeweights.PCAWeightsBrownian"/>
        <provider classname="targetedbeast.edgeweights.PCAWeightsBrownianFullLikelihood"/>
        <provider classname="targetedbeast.edgeweights.ConstantWeights"/>
        <provider classname="targetedbeast.edgeweights.FelsensteinWeights"/>
        <provider classname="targetedbeast.edgeweights.LearnedWeights"/>
        <provider classname="targetedbeast.edgeweights.FelsensteinWeights2"/>
        <provider classname="targetedbeast.edgeweights.PartialWeights"/>
        <provider classname="targetedbeast.edgeweights.ThreadedPartialWeights"/>
        <provider classname="targetedbeast.edgeweights.SourceTargetWeights"/>
        <provider classname="targetedbeast.edgeweights.BranchLengthWeights"/>
        <provider classname="targetedbeast.edgeweights.CombinedEdgeWeights"/>

        <provider classname="targetedbeast.weighttransform.SpsaTuner"/>

        <provider classname="targetedbeast.benchmark.BenchmarkMCMC"/>
        <provider classname="targetedbeast.weighttransform.GridTuner"/>
        <provider classname="targetedbeast.weighttransform.RatioGridTuner"/>
        <provider classname="targetedbeast.weighttransform.PowerOffsetTransform"/>
        <provider classname="targetedbeast.weighttransform.ExpOffsetTransform"/>
        <provider classname="targetedbeast.weighttransform.TreeJumpFunction"/>
        <provider classname="targetedbeast.weighttransform.KuhnerFelsensteinMetric"/>

        <provider classname="targetedbeast.init.ensureNoZeroEdgeLength"/>

        <provider classname="targetedbeast.likelihood.SlowTreeLikelihood"/>
        <provider classname="targetedbeast.likelihood.RapidTreeLikelihood"/>
        <provider classname="targetedbeast.logger.CladeLogger"/>

        <provider classname="targetedbeast.alignment.ConsensusAlignment"/>
        <provider classname="targetedbeast.alignment.RapidAlignment"/>

        <provider classname="targetedbeast.coalescent.RapidTreeIntervals"/>

        <provider classname="targetedbeast.operators.AdaptableOperatorSampler"/>
        <provider classname="targetedbeast.operators.IntervalScaleOperator"/>
        <provider classname="targetedbeast.operators.BactrianIntervalScaleOperator"/>
        <provider classname="targetedbeast.operators.HeightBasedNodeRandomizer"/>
        <provider classname="targetedbeast.operators.WeightBasedNodeRandomizer"/>
        <provider classname="targetedbeast.operators.RangeSlide"/>
        <provider classname="targetedbeast.operators.TargetedWilsonBalding"/>
        <provider classname="targetedbeast.operators.TargetedWilsonBaldingFixedHeight"/>
        <provider classname="targetedbeast.operators.TargetedWilsonBaldingHeightDelta"/>
        <provider classname="targetedbeast.operators.WeightedWideOperator"/>

        <provider classname="targetedbeast.operatorschedule.TargetedOperatorSchedule"/>
        <provider classname="targetedbeast.edgeweights.ConstantWeights"/>
        <provider classname="targetedbeast.likelihood.RapidGenericTreeLikelihood"/>
        <provider classname="targetedbeast.coalescent.RapidCoalescent"/>
        <provider classname="targetedbeast.operators.NodeRandomizer2"/>
        <provider classname="targetedbeast.operators.NodeRandomizer22"/>
        <provider classname="targetedbeast.util.Alignment2PCA"/>

        <!-- lib/feast.v10.6.0.jar is bundled for infB/lassaL example data loading;
             registered here (not as an installed 'feast' package) since only these
             two classes are used. -->
        <provider classname="feast.fileio.AlignmentFromFasta"/>
        <provider classname="feast.fileio.TraitSetFromTaxonSet"/>
    </service>

  <!-- targetedbeast.altoperators.* is unfinished scratch code (LengthConsistentUpDown.scaleTree
       still calls System.exit) and is deliberately NOT registered as a service, matching the
       original package. It is kept compiling but is not reachable from XML. -->

  <!-- Add other dependencies as necessary. -->
</package>
