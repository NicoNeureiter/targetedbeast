# Snakefile for building the TargetedBeast package, generating BEAST XMLs and
# running them.
#
# Pipeline:
#   1. `ant build` (re)compiles the targetedbeast package and the resulting
#      dist/TargetedBeast.v*.zip is unpacked into the local BEAST package dir,
#      so BEAST runs always pick up the latest code. This step reruns whenever
#      a Java source file changes.
#   2. `generate_xmls.py` renders run{0..N_REPS-1}.xml into one subdirectory
#      per entry in EDGE_WEIGHTS (under EXAMPLE_ROOT).
#   3. BEAST is run on every run?.xml (wrapped in a timer that records the
#      wall-clock runtime). Subdirectories are processed sequentially (each
#      waits for the previous one to fully finish); the N_REPS instances within
#      a subdirectory may run in parallel (subject to the -j/--cores given to
#      snakemake).
#   4. Per-replicate statistics are collected: loganalyser computes ESS, the
#      .state file gives per-operator acceptance rates, and collect_stats.py
#      combines these with the runtime. Results are aggregated into
#      EXAMPLE_ROOT/mcmc_stats.tsv (loganalyser stats extended with lowest ESS,
#      ESS per hour and the TargetedWilsonBalding acceptance rate) and
#      EXAMPLE_ROOT/operator_acceptance.tsv (all operators, long format).
#
# Usage (from this scripts/ directory):
#   snakemake -j4                 # reps within a subdir run in parallel
#   snakemake -j1                 # everything strictly sequential
#   snakemake -j16 --config parallel_subdirs=1   # all settings at once too
#   snakemake -j16 --config parallel_subdirs=1 beast_threads=2   # 2 cores per chain
#   snakemake --config beast=/path/to/beast
#   snakemake --config n_reps=8   # generate/run 8 replicates per subdirectory

import hashlib
import sys
from pathlib import Path

# Make generate_xmls importable so we reuse its configuration verbatim.
SCRIPT_DIR = Path(workflow.basedir).resolve()
sys.path.insert(0, str(SCRIPT_DIR))

from generate_xmls import EXAMPLE_ROOT, SUBDIRS  # noqa: E402

# `--config quick=1` gives a short comparison suitable for the development loop.
QUICK = bool(int(config.get("quick", 0)))

N_REPS = int(config.get("n_reps", 2 if QUICK else 4))
CHAIN_LENGTH = int(config.get("chain_length", 200_000 if QUICK else 10_000_000))
# Subsample the alignment to this many taxa. The full lassaL_kli22 alignment has 551, which
# is far too slow for a development loop: per-iteration cost grows with the tree size, so
# this is the main knob for trading accuracy against runtime.
N_TAXA = config.get("n_taxa", 60 if QUICK else None)

# Path to the BEAST launcher (override with --config beast=...).
BEAST = config.get("beast", "/Applications/BEAST 2.7.7/bin/beast")

# loganalyser lives next to the beast launcher; allow an explicit override.
_beast_dir = Path(BEAST).parent
LOGANALYSER = config.get(
    "loganalyser",
    str(_beast_dir / "loganalyser") if str(_beast_dir) not in (".", "") else "loganalyser",
)
# Run every setting concurrently instead of one subdirectory at a time; see prev_subdir_done.
PARALLEL_SUBDIRS = bool(int(config.get("parallel_subdirs", 0)))
# Cores to reserve per BEAST run. The tree likelihood has useThreads="true", so a chain is not a
# single-core job, and telling snakemake otherwise oversubscribes the machine.
BEAST_THREADS = int(config.get("beast_threads", 1))
# Burn-in percentage discarded by loganalyser when computing ESS.
BURNIN = int(config.get("burnin", 10))
# Operator whose acceptance rate is added to the summary statistics.
OPERATOR = config.get("operator", "targetedWilsonBalding")

# The targetedbeast package root (where build.xml lives) and where `ant build`
# output should be installed so that BEAST picks up freshly compiled code.
PACKAGE_ROOT = SCRIPT_DIR.parent
DIST_ZIP = PACKAGE_ROOT / "dist" / "TargetedBeast.v1.0.0.zip"
INSTALL_DIR = Path(
    "/Users/nneureiter/Library/Application Support/BEAST/2.7/TargetedBeast"
)
# Marker file produced inside the install dir; used as the build rule's output.
INSTALL_MARKER = INSTALL_DIR / "version.xml"
# Java sources whose changes should trigger a rebuild.
JAVA_SOURCES = [str(p) for p in (PACKAGE_ROOT / "src").rglob("*.java")]

# Subdirectories (in declaration order) and replicate indices.
REPS = list(range(N_REPS))


def beast_seed(wildcards):
    """A distinct, reproducible seed per (setting, replicate).

    BEAST defaults to System.currentTimeMillis(), and since the run?.xml files within a
    subdirectory are byte-identical the seed is the only thing that separates replicates. Reps
    launched in parallel can land in the same millisecond and produce identical chains, which has
    already happened. hashlib rather than hash() because the latter is salted per process.
    """
    digest = hashlib.md5(f"{wildcards.subdir}/{wildcards.rep}".encode()).hexdigest()
    return int(digest[:8], 16)


def prev_subdir_done(wildcards):
    """A subdir's BEAST runs depend on the previous subdir being finished,
    which makes the workflow walk the subdirectories sequentially.

    This is the only thing keeping settings from running concurrently, and it is here for the
    runtime measurement rather than for correctness: ESS per hour is only comparable across
    settings if they all saw the same machine. With `--config parallel_subdirs=1` the edge is
    dropped and snakemake schedules every chain against -j at once, which is much faster but
    makes the runtimes contention-dependent - fine when the comparison is on acceptance or on
    where the tuner settles, not on speed."""
    if PARALLEL_SUBDIRS:
        return []
    idx = SUBDIRS.index(wildcards.subdir)
    if idx == 0:
        return []
    prev = SUBDIRS[idx - 1]
    return str(EXAMPLE_ROOT / prev / ".done")


rule all:
    input:
        str(EXAMPLE_ROOT / "mcmc_stats.tsv"),
        str(EXAMPLE_ROOT / "operator_acceptance.tsv"),


rule build_package:
    input:
        JAVA_SOURCES,
        str(PACKAGE_ROOT / "build.xml"),
        str(PACKAGE_ROOT / "version.xml"),
    output:
        str(INSTALL_MARKER),
    shell:
        "ant -f {PACKAGE_ROOT}/build.xml build && "
        'unzip -o "{DIST_ZIP}" -d "{INSTALL_DIR}"'


rule generate_xmls:
    # Both the template and the renderer are inputs, so editing either one invalidates the
    # XMLs. Without this the rule never re-runs once its outputs exist, and a template change
    # silently leaves the pipeline running the previous XMLs.
    input:
        str(EXAMPLE_ROOT / "template.xml"),
        str(SCRIPT_DIR / "generate_xmls.py"),
    output:
        expand(
            str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.xml"),
            subdir=SUBDIRS,
            rep=REPS,
        ),
    shell:
        "python {SCRIPT_DIR}/generate_xmls.py --n-reps {N_REPS} --chain-length {CHAIN_LENGTH}"
        + (f" --n-taxa {N_TAXA}" if N_TAXA else "")


rule run_beast:
    input:
        xml=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.xml"),
        prev=prev_subdir_done,
        build=str(INSTALL_MARKER),
    threads: BEAST_THREADS
    params:
        seed=beast_seed,
    output:
        trees=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.trees"),
        log=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.log"),
        state=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.xml.state"),
        runtime=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.runtime"),
    shell:
        # Time the BEAST run with the bash SECONDS builtin and record the
        # wall-clock runtime (seconds) only if BEAST succeeds.
        "SECONDS=0; "
        '"{BEAST}" -version_file ../version.xml -overwrite -seed {params.seed} '
        '-working "{input.xml}" && '
        'echo $SECONDS > "{output.runtime}"'


rule subdir_done:
    input:
        expand(
            str(EXAMPLE_ROOT / "{{subdir}}" / "run{rep}.trees"),
            rep=REPS,
        ),
    output:
        touch(str(EXAMPLE_ROOT / "{subdir}" / ".done")),


rule loganalyser:
    input:
        log=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.log"),
    output:
        ess=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.ess.tsv"),
    shell:
        '"{LOGANALYSER}" -oneline -b {BURNIN} -quiet "{input.log}" > "{output.ess}"'


rule run_stats:
    input:
        ess=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.ess.tsv"),
        state=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.xml.state"),
        runtime=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.runtime"),
    output:
        summary=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.stats.tsv"),
        operators=str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.operators.tsv"),
    shell:
        "python {SCRIPT_DIR}/collect_stats.py "
        '--ess-table "{input.ess}" --state "{input.state}" --runtime "{input.runtime}" '
        "--subdir {wildcards.subdir} --rep {wildcards.rep} --operator {OPERATOR} "
        '--summary-out "{output.summary}" --operators-out "{output.operators}"'


def all_summaries(wildcards):
    return expand(
        str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.stats.tsv"),
        subdir=SUBDIRS,
        rep=REPS,
    )


def all_operator_tables(wildcards):
    return expand(
        str(EXAMPLE_ROOT / "{subdir}" / "run{rep}.operators.tsv"),
        subdir=SUBDIRS,
        rep=REPS,
    )


rule aggregate_stats:
    input:
        summaries=all_summaries,
        operators=all_operator_tables,
    output:
        summary=str(EXAMPLE_ROOT / "mcmc_stats.tsv"),
        operators=str(EXAMPLE_ROOT / "operator_acceptance.tsv"),
    run:
        def concat(paths, out_path):
            # Concatenate per-run TSVs, keeping the header from the first only.
            with open(out_path, "w") as out:
                for i, path in enumerate(paths):
                    lines = Path(path).read_text().splitlines()
                    rows = lines if i == 0 else lines[1:]
                    out.write("\n".join(rows) + "\n")

        concat(input.summaries, output.summary)
        concat(input.operators, output.operators)
