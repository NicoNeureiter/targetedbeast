# Snakefile for the evaluation pipeline (targetedbeast-evaluation-pipeline.md, Phase 5).
#
# Rewritten from a BEAST-2.7/Ant, single-dataset (lassaL) harness to a Maven/module-path,
# multi-dataset harness driven by scripts/datasets.yaml. Pipeline, per (dataset, tier, setting,
# rep) cell:
#
#   1. `render_xml.py` renders one cell's run.xml from datasets.yaml + the dataset's own renderer
#      script (render_infb_benchmark_xml.py / render_iecor_benchmark_xml.py) or, for primates,
#      render_xml.py's own render_primates().
#   2. Each run_beast* rule's shell command starts with `mvn -o compile -q &&`: this
#      (re)compiles targetedbeast onto target/classes, which exec:exec's --module-path %classpath
#      picks up directly - no ant, no unzip-into-install-dir, no hardcoded BEAST 2.7 path. This is
#      deliberately *not* a Snakemake `input:` dependency (no rule/marker file for it, unlike the
#      old `rule build`/BUILD_MARKER) - mvn's own incremental compilation already makes a no-op
#      recompile fast, and keeping it out of the DAG means editing an unrelated Java file no
#      longer makes Snakemake consider every already-completed cell stale (it used to, via
#      BUILD_MARKER's mtime touching every cell that depended on it - including reference cells
#      that took ~61 minutes to produce). `write_cell_manifest.py` (run.xml's sha256 + the git
#      commit at run time) is the replacement record of what code actually produced a cell -
#      see `check_reference_freshness.py` / rule check_references below.
#   3. BEAST runs the cell through `mvn -o exec:exec` on the module path, producing
#      run.log/run.trees/run.xml.state/run.opstats.tsv (BenchmarkMCMC's own per-operator +
#      chain-level statistics report), a timed run.runtime, and (only after the run succeeds)
#      cell.manifest.json.
#   4. `smoke`/`fast` tiers stop at opstats.tsv - no ESS claim is made at those chain lengths
#      (Phase 3a). `thorough`/`cross-check` also run loganalyser (ESS is exactly what gates
#      those tiers, per docs/evaluation/where-targeting-wins.md).
#   5. `collect_stats.py` combines opstats.tsv (+ the ESS table, where present) into one summary
#      row per cell; `aggregate` concatenates all cells of a (dataset, tier) into
#      runs/<dataset>/<tier>/summary.tsv.
#
# Usage (from this scripts/ directory, or anywhere with -s scripts/Snakefile):
#   snakemake -j1                          # smoke + fast + thorough, everything except cross-check
#   snakemake -j4                          # reps/settings/datasets run in parallel up to 4 cores
#   snakemake -j1 runs/primates/smoke/summary.tsv
#   snakemake -j2 runs/infb/fast/summary.tsv
#   snakemake -j4 runs/infb/thorough/summary.tsv
#   snakemake -j4 cross_check              # iecor cross-check tier - NEVER part of `all`
#   snakemake -j4 runs/infb/burnin_speed_summary.tsv   # burn-in speed - NEVER part of `all`
#   snakemake --config loganalyser=/path/to/loganalyser burnin=10
#
# Burn-in-speed (Phase 3c, item 2 - fresh naive random starts, paired by seed) is wired in below:
# `reference_band` computes each dataset's 5th-95th percentile log-posterior band from its own
# reference_tier's already-run baseline-setting/rep0 cell (datasets.yaml's reference_tier - never
# a new chain length); `render_burnin_speed`/`run_beast_burnin_speed` render and run a fresh cell
# per (dataset, setting, rep) with that band wired in as referenceLowerBound/referenceUpperBound;
# `burnin_speed_summary` collects the resulting `run.burnin.tsv` files into one table per dataset.
# Explicit target only (`burnin_speed`, mirroring `cross_check`) - never swept into `rule all`,
# since it needs a completed reference band first (itself a long ESS-gated reference_tier run).
#
# Checkpoint/resume (Phase 3c item 1, shared-checkpoint steady-state mixing) is wired into
# thorough/cross-check by default: `render_reference_checkpoint`/`run_beast_reference_checkpoint`
# produce one dataset-level reference chain (the dataset's own reference_tier, baseline setting,
# seed 1000 - the same chain shape and role reference_band already used, reused rather than
# duplicated) whose BenchmarkMCMC also writes `checkpoint.state` at the burn-in boundary
# (checkpointOut, sampleNr==0 - see BenchmarkMCMC javadoc). `run_beast_checkpointed` then copies
# that checkpoint into each thorough/cross-check cell's own state-file path (never read/write the
# shared file directly - parallel cells would clobber it, since a cell's own run also writes its
# final state back to whatever -statefile points at) and runs BEAST with `-resume`, so every
# setting's reps share the same starting point, paired by seed as usual. fast/smoke are unaffected
# (rule run_beast, unchanged, still fresh-starts every cell - Phase 3c item 2's burn-in-speed axis).

import re
from pathlib import Path

import yaml

SCRIPT_DIR = Path(workflow.basedir).resolve()
PROJECT_ROOT = SCRIPT_DIR.parent
RUNS_ROOT = PROJECT_ROOT / "runs"

with open(SCRIPT_DIR / "datasets.yaml", encoding="utf-8") as f:
    REGISTRY = yaml.safe_load(f)

DATASETS = list(REGISTRY)

# loganalyser lives next to the beast3 launchers, not this package - see workspace CLAUDE.md.
LOGANALYSER = config.get(
    "loganalyser",
    str(PROJECT_ROOT.parent / "beast3" / "bin" / "loganalyser"),
)
BURNIN = int(config.get("burnin", 10))

CELL_DIR = str(RUNS_ROOT / "{dataset}" / "{tier}" / "{setting}" / "rep{rep}")

# Constrains the generic render/run_beast rules' {tier} wildcard to real datasets.yaml tiers, so
# it cannot also match the burn-in-speed cells' "burnin-speed" path segment below (which is a
# fixed string there, not a wildcard) - without this, Snakemake would see two rules able to
# produce the same file and raise AmbiguousRuleException.
KNOWN_TIERS = sorted({tier for entry in REGISTRY.values() for tier in entry["tiers"]})
TIER_PATTERN = "|".join(re.escape(tier) for tier in KNOWN_TIERS)

BURNIN_SPEED_CELL_DIR = str(RUNS_ROOT / "{dataset}" / "burnin-speed" / "{setting}" / "rep{rep}")

# Shared checkpoint (Phase 3c, item 1): thorough/cross-check cells resume from a per-dataset
# checkpoint instead of running their own fresh preBurnin (see the module docstring above and rules
# render_reference_checkpoint/run_beast_reference_checkpoint/run_beast_checkpointed below).
# fast/smoke keep the old fresh-start rule (run_beast) - burn-in speed is intentionally measured
# from fresh starts (Phase 3c item 2), and fast/smoke were never ESS-gated anyway. The two tier sets
# partition KNOWN_TIERS, so their wildcard_constraints are mutually exclusive - required, or
# Snakemake would see two rules able to produce the same CELL_DIR outputs.
CHECKPOINT_TIERS = sorted({"thorough", "cross-check"} & set(KNOWN_TIERS))
CHECKPOINT_TIER_PATTERN = "|".join(re.escape(tier) for tier in CHECKPOINT_TIERS)
FRESH_TIERS = sorted(set(KNOWN_TIERS) - set(CHECKPOINT_TIERS))
FRESH_TIER_PATTERN = "|".join(re.escape(tier) for tier in FRESH_TIERS)

REFERENCE_CHECKPOINT_DIR = str(RUNS_ROOT / "{dataset}" / "reference_checkpoint")


def tier_cfg(dataset: str, tier: str) -> dict:
    return REGISTRY[dataset]["tiers"][tier]


def settings_for(dataset: str) -> list[str]:
    return REGISTRY[dataset]["settings"]


def reps_for(dataset: str, tier: str) -> list[int]:
    return list(range(tier_cfg(dataset, tier)["reps"]))


def ess_gated(dataset: str, tier: str) -> bool:
    return bool(tier_cfg(dataset, tier).get("ess_gate", False))


def beast_seed(wildcards) -> int:
    """1000 + rep, shared across settings at a given rep for paired comparisons. Never
    hash(setting, rep) - that was the bug in the pre-rewrite Snakefile (see git history)."""
    return 1000 + int(wildcards.rep)


def tier_targets(include_cross_check: bool) -> list[str]:
    targets = []
    for dataset, entry in REGISTRY.items():
        for tier in entry["tiers"]:
            if tier == "cross-check" and not include_cross_check:
                continue
            targets.append(str(RUNS_ROOT / dataset / tier / "summary.tsv"))
    return targets


rule all:
    # cross-check is never swept in here - it is user-initiated only (rule cross_check below).
    input:
        tier_targets(include_cross_check=False),


rule cross_check:
    input:
        str(RUNS_ROOT / "iecor" / "cross-check" / "summary.tsv"),


def render_inputs(wildcards):
    entry = REGISTRY[wildcards.dataset]
    inputs = [str(SCRIPT_DIR / "render_xml.py"), str(SCRIPT_DIR / "datasets.yaml"),
              str(PROJECT_ROOT / entry["template"])]
    if entry["renderer"]:
        inputs.append(str(SCRIPT_DIR / f"{entry['renderer']}.py"))
    return inputs


rule render:
    input:
        render_inputs,
    output:
        xml=CELL_DIR + "/run.xml",
    wildcard_constraints:
        tier=TIER_PATTERN,
    shell:
        "python3 {SCRIPT_DIR}/render_xml.py --dataset {wildcards.dataset} --tier {wildcards.tier} "
        "--setting {wildcards.setting} --rep {wildcards.rep} "
        '--out-dir "$(dirname {output.xml})"'


rule run_beast:
    input:
        xml=CELL_DIR + "/run.xml",
    params:
        seed=beast_seed,
    output:
        log=CELL_DIR + "/run.log",
        trees=CELL_DIR + "/run.trees",
        state=CELL_DIR + "/run.xml.state",
        opstats=CELL_DIR + "/run.opstats.tsv",
        runtime=CELL_DIR + "/run.runtime",
        manifest=CELL_DIR + "/cell.manifest.json",
    wildcard_constraints:
        # fast/smoke only - thorough/cross-check use run_beast_checkpointed below.
        tier=FRESH_TIER_PATTERN,
    shell:
        # The proven invocation used throughout this project's Phase 0/3a experiments (see
        # docs/evaluation/where-targeting-wins.md); beast.main is already this pom's default but
        # named explicitly here for clarity.
        #
        # -statefile is mandatory here, not cosmetic: State.storeToFile defaults to deriving the
        # state filename from the input xml's own basename ("run.xml" -> "run.xml.state") written
        # relative to mvn's cwd (${{project.basedir}}, fixed by the pom, the same for every cell).
        # Since every rendered run.xml is literally named "run.xml", every cell would otherwise
        # clobber the same "<project root>/run.xml.state" - confirmed by running one cell without
        # this flag and finding the state file in the project root, not the cell directory.
        #
        # `mvn -o compile -q` is prefixed here rather than declared as a Snakemake input (no
        # BUILD_MARKER) - see module docstring above.
        'cd "{PROJECT_ROOT}" && mvn -o compile -q && SECONDS=0 && '
        "mvn -o exec:exec -Dbeast.main=beast.base.minimal.BeastMain "
        '-Dbeast.args="-overwrite -seed {params.seed} -statefile {output.state} {input.xml}" && '
        'echo $SECONDS > "{output.runtime}" && '
        "python3 {SCRIPT_DIR}/write_cell_manifest.py --repo \"{PROJECT_ROOT}\" "
        '--xml "{input.xml}" --dataset {wildcards.dataset} --tier {wildcards.tier} '
        "--setting {wildcards.setting} --rep {wildcards.rep} --seed {params.seed} "
        '--out "{output.manifest}"'


# ---------------------------------------------------------------------------------------------
# Shared checkpoint (Phase 3c, item 1). thorough/cross-check cells resume from one dataset-level
# reference chain instead of each running its own fresh preBurnin - see module docstring above.
# ---------------------------------------------------------------------------------------------


rule render_reference_checkpoint:
    input:
        render_inputs,
    output:
        xml=REFERENCE_CHECKPOINT_DIR + "/run.xml",
    params:
        tier=lambda wc: reference_tier_of(wc.dataset),
        setting=lambda wc: settings_for(wc.dataset)[0],
    shell:
        # Same chain shape as reference_band always used (the dataset's reference_tier, baseline
        # setting) - this rule and reference_band now share this one run instead of reference_band
        # deriving its input from a thorough/cross-check tier cell, which - now that those cells
        # resume from this checkpoint by default - would otherwise be circular (that cell would
        # need the checkpoint this run produces).
        "python3 {SCRIPT_DIR}/render_xml.py --dataset {wildcards.dataset} --tier {params.tier} "
        "--setting {params.setting} --rep 0 "
        '--out-dir "$(dirname {output.xml})" '
        '--checkpoint-out "$(dirname {output.xml})/checkpoint.state"'


rule run_beast_reference_checkpoint:
    input:
        xml=REFERENCE_CHECKPOINT_DIR + "/run.xml",
    params:
        tier=lambda wc: reference_tier_of(wc.dataset),
        setting=lambda wc: settings_for(wc.dataset)[0],
    output:
        log=REFERENCE_CHECKPOINT_DIR + "/run.log",
        trees=REFERENCE_CHECKPOINT_DIR + "/run.trees",
        state=REFERENCE_CHECKPOINT_DIR + "/run.xml.state",
        checkpoint=REFERENCE_CHECKPOINT_DIR + "/checkpoint.state",
        opstats=REFERENCE_CHECKPOINT_DIR + "/run.opstats.tsv",
        runtime=REFERENCE_CHECKPOINT_DIR + "/run.runtime",
        manifest=REFERENCE_CHECKPOINT_DIR + "/cell.manifest.json",
    shell:
        # Seed 1000, matching seed=1000+rep at rep=0 (beast_seed) - this run stands in for what
        # used to be the baseline-setting/rep0 thorough/cross-check cell, at the same seed.
        # checkpoint.state is BenchmarkMCMC's own output (checkpointOut, written at sampleNr==0 -
        # the burn-in boundary), not something this shell command produces directly.
        'cd "{PROJECT_ROOT}" && mvn -o compile -q && SECONDS=0 && '
        "mvn -o exec:exec -Dbeast.main=beast.base.minimal.BeastMain "
        '-Dbeast.args="-overwrite -seed 1000 -statefile {output.state} {input.xml}" && '
        'echo $SECONDS > "{output.runtime}" && '
        "python3 {SCRIPT_DIR}/write_cell_manifest.py --repo \"{PROJECT_ROOT}\" "
        '--xml "{input.xml}" --dataset {wildcards.dataset} --tier {params.tier} '
        "--setting {params.setting} --rep 0 --seed 1000 "
        '--out "{output.manifest}"'


def checkpoint_donor_state(wildcards):
    return str(RUNS_ROOT / wildcards.dataset / "reference_checkpoint" / "checkpoint.state")


rule run_beast_checkpointed:
    input:
        xml=CELL_DIR + "/run.xml",
        donor_checkpoint=checkpoint_donor_state,
    params:
        seed=beast_seed,
    output:
        log=CELL_DIR + "/run.log",
        trees=CELL_DIR + "/run.trees",
        state=CELL_DIR + "/run.xml.state",
        opstats=CELL_DIR + "/run.opstats.tsv",
        runtime=CELL_DIR + "/run.runtime",
        manifest=CELL_DIR + "/cell.manifest.json",
    wildcard_constraints:
        tier=CHECKPOINT_TIER_PATTERN,
    shell:
        # Copy first (never resume straight from the shared donor_checkpoint file): this cell's own
        # run ends by writing its final state back to whatever -statefile points at, so every
        # setting/rep resuming from the same shared file directly would clobber it for whichever
        # cell reads it next (confirmed the hard way - see BenchmarkMCMCCrossSettingResumeTest,
        # which hit exactly this before the copy step was added there too).
        #
        # -resume (not -overwrite): restores state from the copied file and forces burnIn=0 in
        # core MCMC regardless of the rendered XML's own preBurnin value - the cell's rendered XML
        # is otherwise identical to a fresh-start cell's (same pre_burnin/chain_length/jumpInterval
        # from datasets.yaml), it just never uses its own preBurnin on resume.
        'cd "{PROJECT_ROOT}" && mvn -o compile -q && SECONDS=0 && '
        'cp "{input.donor_checkpoint}" "{output.state}" && '
        "mvn -o exec:exec -Dbeast.main=beast.base.minimal.BeastMain "
        '-Dbeast.args="-resume -seed {params.seed} -statefile {output.state} {input.xml}" && '
        'echo $SECONDS > "{output.runtime}" && '
        "python3 {SCRIPT_DIR}/write_cell_manifest.py --repo \"{PROJECT_ROOT}\" "
        '--xml "{input.xml}" --dataset {wildcards.dataset} --tier {wildcards.tier} '
        "--setting {wildcards.setting} --rep {wildcards.rep} --seed {params.seed} "
        '--out "{output.manifest}"'


rule loganalyser:
    input:
        log=CELL_DIR + "/run.log",
    output:
        ess=CELL_DIR + "/run.ess.tsv",
    shell:
        '"{LOGANALYSER}" -oneline -b {BURNIN} -quiet "{input.log}" > "{output.ess}"'


def collect_ess_input(wildcards):
    if ess_gated(wildcards.dataset, wildcards.tier):
        return CELL_DIR.format(**wildcards) + "/run.ess.tsv"
    return []


rule collect_cell:
    input:
        opstats=CELL_DIR + "/run.opstats.tsv",
        runtime=CELL_DIR + "/run.runtime",
        ess=collect_ess_input,
    output:
        summary=CELL_DIR + "/cell.summary.tsv",
    params:
        ess_flag=lambda wc, input: f'--ess-table "{input.ess}"' if input.ess else "",
    shell:
        "python3 {SCRIPT_DIR}/collect_stats.py "
        '--opstats "{input.opstats}" --runtime "{input.runtime}" {params.ess_flag} '
        "--dataset {wildcards.dataset} --tier {wildcards.tier} --setting {wildcards.setting} "
        '--rep {wildcards.rep} --summary-out "{output.summary}"'


def cell_summaries(wildcards):
    return expand(
        CELL_DIR + "/cell.summary.tsv",
        dataset=wildcards.dataset,
        tier=wildcards.tier,
        setting=settings_for(wildcards.dataset),
        rep=reps_for(wildcards.dataset, wildcards.tier),
    )


rule aggregate:
    input:
        cell_summaries,
    output:
        summary=str(RUNS_ROOT / "{dataset}" / "{tier}" / "summary.tsv"),
    run:
        with open(output.summary, "w") as out:
            for i, path in enumerate(input):
                lines = Path(path).read_text().splitlines()
                rows = lines if i == 0 else lines[1:]
                out.write("\n".join(rows) + "\n")
        # Warn-only, informational only - never gates or blocks this rule (see rule
        # check_references below); this is a one-line pointer, not the check itself.
        print(f"To check these cells' provenance against HEAD: "
              f"snakemake -j1 runs/{wildcards.dataset}/{wildcards.tier}/.check_references.done")


rule check_references:
    # Explicit, per-(dataset, tier) target only, requested by output path (rule has wildcards, so
    # `snakemake check_references` alone is ambiguous) - mirrors cross_check/burnin_speed_summary,
    # never swept into `rule all`:
    #   snakemake -j1 runs/infb/thorough/.check_references.done
    # Warn-only report (check_reference_freshness.py never exits non-zero).
    input:
        lambda wc: expand(
            CELL_DIR + "/cell.manifest.json",
            dataset=wc.dataset, tier=wc.tier,
            setting=settings_for(wc.dataset), rep=reps_for(wc.dataset, wc.tier),
        ),
    output:
        touch(str(RUNS_ROOT / "{dataset}" / "{tier}" / ".check_references.done")),
    wildcard_constraints:
        tier=TIER_PATTERN,
    params:
        # check_reference_freshness.py takes cell directories, not manifest files directly - each
        # input path is CELL_DIR + "/cell.manifest.json", so its parent is the cell directory.
        cell_dirs=lambda wc, input: [str(Path(p).parent) for p in input],
    shell:
        "python3 {SCRIPT_DIR}/check_reference_freshness.py --repo \"{PROJECT_ROOT}\" "
        "{params.cell_dirs}"


# ---------------------------------------------------------------------------------------------
# Burn-in speed (Phase 3c, item 2). Explicit target only - `snakemake burnin_speed_<dataset>`,
# never part of `rule all` (see the module docstring above for why).
# ---------------------------------------------------------------------------------------------


def reference_tier_of(dataset: str) -> str:
    return REGISTRY[dataset]["reference_tier"]


def reference_cell_log(wildcards):
    """The dataset's reference-checkpoint donor run (render_reference_checkpoint /
    run_beast_reference_checkpoint above) - same chain shape/role the old baseline-setting/rep0
    thorough/cross-check cell used to serve, but now a dedicated target: since those tier cells
    resume from this run's checkpoint by default (Phase 3c item 1), deriving the band from one of
    them would be circular."""
    return str(RUNS_ROOT / wildcards.dataset / "reference_checkpoint" / "run.log")


rule reference_band:
    input:
        log=reference_cell_log,
        script=str(SCRIPT_DIR / "compute_reference_band.py"),
    output:
        band=str(RUNS_ROOT / "{dataset}" / "reference_band.json"),
    shell:
        "python3 {SCRIPT_DIR}/compute_reference_band.py --log {input.log} --burnin {BURNIN} "
        '--out "{output.band}"'


rule render_burnin_speed:
    input:
        band=str(RUNS_ROOT / "{dataset}" / "reference_band.json"),
        extra=render_inputs,
    output:
        xml=BURNIN_SPEED_CELL_DIR + "/run.xml",
    params:
        tier=lambda wc: reference_tier_of(wc.dataset),
    shell:
        # Same chain shape (pre_burnin/chain_length/jump_interval) as the dataset's reference_tier
        # cell above - a fresh naive random start at that shape, not a resumed checkpoint (Phase
        # 3c item 1 is separate, out of scope here) - with the reference band wired in.
        "python3 {SCRIPT_DIR}/render_xml.py --dataset {wildcards.dataset} --tier {params.tier} "
        "--setting {wildcards.setting} --rep {wildcards.rep} "
        '--out-dir "$(dirname {output.xml})" --reference-band "{input.band}"'


rule run_beast_burnin_speed:
    input:
        xml=BURNIN_SPEED_CELL_DIR + "/run.xml",
    params:
        seed=beast_seed,
        tier=lambda wc: reference_tier_of(wc.dataset),
    output:
        log=BURNIN_SPEED_CELL_DIR + "/run.log",
        trees=BURNIN_SPEED_CELL_DIR + "/run.trees",
        state=BURNIN_SPEED_CELL_DIR + "/run.xml.state",
        opstats=BURNIN_SPEED_CELL_DIR + "/run.opstats.tsv",
        burnin=BURNIN_SPEED_CELL_DIR + "/run.burnin.tsv",
        runtime=BURNIN_SPEED_CELL_DIR + "/run.runtime",
        manifest=BURNIN_SPEED_CELL_DIR + "/cell.manifest.json",
    shell:
        # Identical invocation to rule run_beast; run.burnin.tsv is BenchmarkMCMC's own extra
        # output, written on close() because referenceLowerBound/referenceUpperBound are set on
        # this cell's XML (see BenchmarkMCMC.writeBurnInSpeedFile). manifest's tier field records
        # the reference_tier chain shape actually used (see render_burnin_speed), not the literal
        # "burnin-speed" path segment.
        'cd "{PROJECT_ROOT}" && mvn -o compile -q && SECONDS=0 && '
        "mvn -o exec:exec -Dbeast.main=beast.base.minimal.BeastMain "
        '-Dbeast.args="-overwrite -seed {params.seed} -statefile {output.state} {input.xml}" && '
        'echo $SECONDS > "{output.runtime}" && '
        "python3 {SCRIPT_DIR}/write_cell_manifest.py --repo \"{PROJECT_ROOT}\" "
        '--xml "{input.xml}" --dataset {wildcards.dataset} --tier {params.tier} '
        "--setting {wildcards.setting} --rep {wildcards.rep} --seed {params.seed} "
        '--out "{output.manifest}"'


rule collect_burnin_speed_cell:
    input:
        burnin=BURNIN_SPEED_CELL_DIR + "/run.burnin.tsv",
    output:
        summary=BURNIN_SPEED_CELL_DIR + "/cell.burnin_summary.tsv",
    shell:
        "python3 {SCRIPT_DIR}/collect_burnin_speed.py --burnin {input.burnin} "
        "--dataset {wildcards.dataset} --setting {wildcards.setting} --rep {wildcards.rep} "
        '--summary-out "{output.summary}"'


def burnin_speed_cell_summaries(wildcards):
    return expand(
        BURNIN_SPEED_CELL_DIR + "/cell.burnin_summary.tsv",
        dataset=wildcards.dataset,
        setting=settings_for(wildcards.dataset),
        rep=reps_for(wildcards.dataset, reference_tier_of(wildcards.dataset)),
    )


# No `all`-swept target: request runs/<dataset>/burnin_speed_summary.tsv directly (it is never
# in tier_targets(), so `snakemake -j4` alone will not build it), e.g.:
#   snakemake -j4 runs/infb/burnin_speed_summary.tsv
rule burnin_speed_summary:
    input:
        burnin_speed_cell_summaries,
    output:
        summary=str(RUNS_ROOT / "{dataset}" / "burnin_speed_summary.tsv"),
    run:
        with open(output.summary, "w") as out:
            for i, path in enumerate(input):
                lines = Path(path).read_text().splitlines()
                rows = lines if i == 0 else lines[1:]
                out.write("\n".join(rows) + "\n")
