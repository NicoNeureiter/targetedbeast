# Snakefile for the evaluation pipeline (targetedbeast-evaluation-pipeline.md, Phase 5).
#
# Rewritten from a BEAST-2.7/Ant, single-dataset (lassaL) harness to a Maven/module-path,
# multi-dataset harness driven by scripts/datasets.yaml. Pipeline, per (dataset, tier, setting,
# rep) cell:
#
#   1. `mvn -o compile` (re)compiles targetedbeast onto target/classes, which exec:exec's
#      --module-path %classpath picks up directly - no ant, no unzip-into-install-dir, no
#      hardcoded BEAST 2.7 path. This step reruns whenever a Java source file changes.
#   2. `render_xml.py` renders one cell's run.xml from datasets.yaml + the dataset's own renderer
#      script (render_infb_benchmark_xml.py / render_iecor_benchmark_xml.py) or, for primates,
#      render_xml.py's own render_primates().
#   3. BEAST runs the cell through `mvn -o exec:exec` on the module path, producing
#      run.log/run.trees/run.xml.state/run.opstats.tsv (BenchmarkMCMC's own per-operator +
#      chain-level statistics report) and a timed run.runtime.
#   4. `smoke`/`fast` tiers stop at opstats.tsv - no ESS claim is made at those chain lengths
#      (Phase 3a). `thorough`/`cross-check` also run loganalyser (ESS is exactly what gates
#      those tiers, per docs/evaluation/where-targeting-wins.md).
#   5. `collect_stats.py` combines opstats.tsv (+ the ESS table, where present) into one summary
#      row per cell; `aggregate` concatenates all cells of a (dataset, tier) into
#      runs/<dataset>/<tier>/summary.tsv.
#
# Usage (from this scripts/ directory, or anywhere with -s scripts/Snakefile):
#   snakemake -j1                          # smoke + fast + thorough, everything except cross-check
#   snakemake -j4                          # reps/settings/datasets run in parallel up to 4 cores
#   snakemake -j1 runs/primates/smoke/summary.tsv
#   snakemake -j2 runs/infb/fast/summary.tsv
#   snakemake -j4 runs/infb/thorough/summary.tsv
#   snakemake -j4 cross_check              # iecor cross-check tier - NEVER part of `all`
#   snakemake -j4 runs/infb/burnin_speed_summary.tsv   # burn-in speed - NEVER part of `all`
#   snakemake --config loganalyser=/path/to/loganalyser burnin=10
#
# Burn-in-speed (Phase 3c, item 2 - fresh naive random starts, paired by seed) is wired in below:
# `reference_band` computes each dataset's 5th-95th percentile log-posterior band from its own
# reference_tier's already-run baseline-setting/rep0 cell (datasets.yaml's reference_tier - never
# a new chain length); `render_burnin_speed`/`run_beast_burnin_speed` render and run a fresh cell
# per (dataset, setting, rep) with that band wired in as referenceLowerBound/referenceUpperBound;
# `burnin_speed_summary` collects the resulting `run.burnin.tsv` files into one table per dataset.
# Explicit target only (`burnin_speed`, mirroring `cross_check`) - never swept into `rule all`,
# since it needs a completed reference band first (itself a long ESS-gated reference_tier run).
#
# Checkpoint/resume (Phase 3c item 1, shared-checkpoint steady-state mixing) is a separate,
# not-yet-landed piece and is out of scope here - no rule for it exists yet, deliberately.

import re
from pathlib import Path

import yaml

SCRIPT_DIR = Path(workflow.basedir).resolve()
PROJECT_ROOT = SCRIPT_DIR.parent
RUNS_ROOT = PROJECT_ROOT / "runs"

with open(SCRIPT_DIR / "datasets.yaml", encoding="utf-8") as f:
    REGISTRY = yaml.safe_load(f)

DATASETS = list(REGISTRY)

# loganalyser lives next to the beast3 launchers, not this package - see workspace CLAUDE.md.
LOGANALYSER = config.get(
    "loganalyser",
    str(PROJECT_ROOT.parent / "beast3" / "bin" / "loganalyser"),
)
BURNIN = int(config.get("burnin", 10))

JAVA_SOURCES = [str(p) for p in (PROJECT_ROOT / "src" / "main" / "java").rglob("*.java")]
BUILD_MARKER = str(PROJECT_ROOT / "target" / ".compiled.marker")

CELL_DIR = str(RUNS_ROOT / "{dataset}" / "{tier}" / "{setting}" / "rep{rep}")

# Constrains the generic render/run_beast rules' {tier} wildcard to real datasets.yaml tiers, so
# it cannot also match the burn-in-speed cells' "burnin-speed" path segment below (which is a
# fixed string there, not a wildcard) - without this, Snakemake would see two rules able to
# produce the same file and raise AmbiguousRuleException.
KNOWN_TIERS = sorted({tier for entry in REGISTRY.values() for tier in entry["tiers"]})
TIER_PATTERN = "|".join(re.escape(tier) for tier in KNOWN_TIERS)

BURNIN_SPEED_CELL_DIR = str(RUNS_ROOT / "{dataset}" / "burnin-speed" / "{setting}" / "rep{rep}")


def tier_cfg(dataset: str, tier: str) -> dict:
    return REGISTRY[dataset]["tiers"][tier]


def settings_for(dataset: str) -> list[str]:
    return REGISTRY[dataset]["settings"]


def reps_for(dataset: str, tier: str) -> list[int]:
    return list(range(tier_cfg(dataset, tier)["reps"]))


def ess_gated(dataset: str, tier: str) -> bool:
    return bool(tier_cfg(dataset, tier).get("ess_gate", False))


def beast_seed(wildcards) -> int:
    """1000 + rep, shared across settings at a given rep for paired comparisons. Never
    hash(setting, rep) - that was the bug in the pre-rewrite Snakefile (see git history)."""
    return 1000 + int(wildcards.rep)


def tier_targets(include_cross_check: bool) -> list[str]:
    targets = []
    for dataset, entry in REGISTRY.items():
        for tier in entry["tiers"]:
            if tier == "cross-check" and not include_cross_check:
                continue
            targets.append(str(RUNS_ROOT / dataset / tier / "summary.tsv"))
    return targets


rule all:
    # cross-check is never swept in here - it is user-initiated only (rule cross_check below).
    input:
        tier_targets(include_cross_check=False),


rule cross_check:
    input:
        str(RUNS_ROOT / "iecor" / "cross-check" / "summary.tsv"),


rule build:
    input:
        JAVA_SOURCES,
        str(PROJECT_ROOT / "pom.xml"),
    output:
        touch(BUILD_MARKER),
    shell:
        # compile, not package: exec:exec's module path reads target/classes directly, and
        # package additionally builds the distributable zip / runs the assembly plugin, which
        # nothing in this pipeline needs (mvn package remains the right command for that,
        # unrelated to running benchmark cells).
        'cd "{PROJECT_ROOT}" && mvn -o compile -q'


def render_inputs(wildcards):
    entry = REGISTRY[wildcards.dataset]
    inputs = [str(SCRIPT_DIR / "render_xml.py"), str(SCRIPT_DIR / "datasets.yaml"),
              str(PROJECT_ROOT / entry["template"])]
    if entry["renderer"]:
        inputs.append(str(SCRIPT_DIR / f"{entry['renderer']}.py"))
    return inputs


rule render:
    input:
        render_inputs,
    output:
        xml=CELL_DIR + "/run.xml",
    wildcard_constraints:
        tier=TIER_PATTERN,
    shell:
        "python3 {SCRIPT_DIR}/render_xml.py --dataset {wildcards.dataset} --tier {wildcards.tier} "
        "--setting {wildcards.setting} --rep {wildcards.rep} "
        '--out-dir "$(dirname {output.xml})"'


rule run_beast:
    input:
        xml=CELL_DIR + "/run.xml",
        build=BUILD_MARKER,
    params:
        seed=beast_seed,
    output:
        log=CELL_DIR + "/run.log",
        trees=CELL_DIR + "/run.trees",
        state=CELL_DIR + "/run.xml.state",
        opstats=CELL_DIR + "/run.opstats.tsv",
        runtime=CELL_DIR + "/run.runtime",
    wildcard_constraints:
        tier=TIER_PATTERN,
    shell:
        # The proven invocation used throughout this project's Phase 0/3a experiments (see
        # docs/evaluation/where-targeting-wins.md); beast.main is already this pom's default but
        # named explicitly here for clarity.
        #
        # -statefile is mandatory here, not cosmetic: State.storeToFile defaults to deriving the
        # state filename from the input xml's own basename ("run.xml" -> "run.xml.state") written
        # relative to mvn's cwd (${{project.basedir}}, fixed by the pom, the same for every cell).
        # Since every rendered run.xml is literally named "run.xml", every cell would otherwise
        # clobber the same "<project root>/run.xml.state" - confirmed by running one cell without
        # this flag and finding the state file in the project root, not the cell directory.
        'cd "{PROJECT_ROOT}" && SECONDS=0 && '
        "mvn -o exec:exec -Dbeast.main=beast.base.minimal.BeastMain "
        '-Dbeast.args="-overwrite -seed {params.seed} -statefile {output.state} {input.xml}" && '
        'echo $SECONDS > "{output.runtime}"'


rule loganalyser:
    input:
        log=CELL_DIR + "/run.log",
    output:
        ess=CELL_DIR + "/run.ess.tsv",
    shell:
        '"{LOGANALYSER}" -oneline -b {BURNIN} -quiet "{input.log}" > "{output.ess}"'


def collect_ess_input(wildcards):
    if ess_gated(wildcards.dataset, wildcards.tier):
        return CELL_DIR.format(**wildcards) + "/run.ess.tsv"
    return []


rule collect_cell:
    input:
        opstats=CELL_DIR + "/run.opstats.tsv",
        runtime=CELL_DIR + "/run.runtime",
        ess=collect_ess_input,
    output:
        summary=CELL_DIR + "/cell.summary.tsv",
    params:
        ess_flag=lambda wc, input: f'--ess-table "{input.ess}"' if input.ess else "",
    shell:
        "python3 {SCRIPT_DIR}/collect_stats.py "
        '--opstats "{input.opstats}" --runtime "{input.runtime}" {params.ess_flag} '
        "--dataset {wildcards.dataset} --tier {wildcards.tier} --setting {wildcards.setting} "
        '--rep {wildcards.rep} --summary-out "{output.summary}"'


def cell_summaries(wildcards):
    return expand(
        CELL_DIR + "/cell.summary.tsv",
        dataset=wildcards.dataset,
        tier=wildcards.tier,
        setting=settings_for(wildcards.dataset),
        rep=reps_for(wildcards.dataset, wildcards.tier),
    )


rule aggregate:
    input:
        cell_summaries,
    output:
        summary=str(RUNS_ROOT / "{dataset}" / "{tier}" / "summary.tsv"),
    run:
        with open(output.summary, "w") as out:
            for i, path in enumerate(input):
                lines = Path(path).read_text().splitlines()
                rows = lines if i == 0 else lines[1:]
                out.write("\n".join(rows) + "\n")


# ---------------------------------------------------------------------------------------------
# Burn-in speed (Phase 3c, item 2). Explicit target only - `snakemake burnin_speed_<dataset>`,
# never part of `rule all` (see the module docstring above for why).
# ---------------------------------------------------------------------------------------------


def reference_tier_of(dataset: str) -> str:
    return REGISTRY[dataset]["reference_tier"]


def reference_cell_log(wildcards):
    """The already-defined baseline-setting/rep0 cell of the dataset's own reference_tier - reuses
    the generic render/run_beast rules unmodified, so this never invents a new chain length."""
    tier = reference_tier_of(wildcards.dataset)
    setting = settings_for(wildcards.dataset)[0]
    return str(RUNS_ROOT / wildcards.dataset / tier / setting / "rep0" / "run.log")


rule reference_band:
    input:
        log=reference_cell_log,
        script=str(SCRIPT_DIR / "compute_reference_band.py"),
    output:
        band=str(RUNS_ROOT / "{dataset}" / "reference_band.json"),
    shell:
        "python3 {SCRIPT_DIR}/compute_reference_band.py --log {input.log} --burnin {BURNIN} "
        '--out "{output.band}"'


rule render_burnin_speed:
    input:
        band=str(RUNS_ROOT / "{dataset}" / "reference_band.json"),
        extra=render_inputs,
    output:
        xml=BURNIN_SPEED_CELL_DIR + "/run.xml",
    params:
        tier=lambda wc: reference_tier_of(wc.dataset),
    shell:
        # Same chain shape (pre_burnin/chain_length/jump_interval) as the dataset's reference_tier
        # cell above - a fresh naive random start at that shape, not a resumed checkpoint (Phase
        # 3c item 1 is separate, out of scope here) - with the reference band wired in.
        "python3 {SCRIPT_DIR}/render_xml.py --dataset {wildcards.dataset} --tier {params.tier} "
        "--setting {wildcards.setting} --rep {wildcards.rep} "
        '--out-dir "$(dirname {output.xml})" --reference-band "{input.band}"'


rule run_beast_burnin_speed:
    input:
        xml=BURNIN_SPEED_CELL_DIR + "/run.xml",
        build=BUILD_MARKER,
    params:
        seed=beast_seed,
    output:
        log=BURNIN_SPEED_CELL_DIR + "/run.log",
        trees=BURNIN_SPEED_CELL_DIR + "/run.trees",
        state=BURNIN_SPEED_CELL_DIR + "/run.xml.state",
        opstats=BURNIN_SPEED_CELL_DIR + "/run.opstats.tsv",
        burnin=BURNIN_SPEED_CELL_DIR + "/run.burnin.tsv",
        runtime=BURNIN_SPEED_CELL_DIR + "/run.runtime",
    shell:
        # Identical invocation to rule run_beast; run.burnin.tsv is BenchmarkMCMC's own extra
        # output, written on close() because referenceLowerBound/referenceUpperBound are set on
        # this cell's XML (see BenchmarkMCMC.writeBurnInSpeedFile).
        'cd "{PROJECT_ROOT}" && SECONDS=0 && '
        "mvn -o exec:exec -Dbeast.main=beast.base.minimal.BeastMain "
        '-Dbeast.args="-overwrite -seed {params.seed} -statefile {output.state} {input.xml}" && '
        'echo $SECONDS > "{output.runtime}"'


rule collect_burnin_speed_cell:
    input:
        burnin=BURNIN_SPEED_CELL_DIR + "/run.burnin.tsv",
    output:
        summary=BURNIN_SPEED_CELL_DIR + "/cell.burnin_summary.tsv",
    shell:
        "python3 {SCRIPT_DIR}/collect_burnin_speed.py --burnin {input.burnin} "
        "--dataset {wildcards.dataset} --setting {wildcards.setting} --rep {wildcards.rep} "
        '--summary-out "{output.summary}"'


def burnin_speed_cell_summaries(wildcards):
    return expand(
        BURNIN_SPEED_CELL_DIR + "/cell.burnin_summary.tsv",
        dataset=wildcards.dataset,
        setting=settings_for(wildcards.dataset),
        rep=reps_for(wildcards.dataset, reference_tier_of(wildcards.dataset)),
    )


# No `all`-swept target: request runs/<dataset>/burnin_speed_summary.tsv directly (it is never
# in tier_targets(), so `snakemake -j4` alone will not build it), e.g.:
#   snakemake -j4 runs/infb/burnin_speed_summary.tsv
rule burnin_speed_summary:
    input:
        burnin_speed_cell_summaries,
    output:
        summary=str(RUNS_ROOT / "{dataset}" / "burnin_speed_summary.tsv"),
    run:
        with open(output.summary, "w") as out:
            for i, path in enumerate(input):
                lines = Path(path).read_text().splitlines()
                rows = lines if i == 0 else lines[1:]
                out.write("\n".join(rows) + "\n")
